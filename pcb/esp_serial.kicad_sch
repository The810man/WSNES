	(text "ESP-side serial address/data access (5 V HCT shift registers)"
		(exclude_from_sim no)
		(at 17.78 15.24 0)
		(effects
			(font (size 2.5 2.5) (thickness 0.5) (bold yes))
			(justify left top)
		)
		(uuid "41aac9fd-2cf4-502a-8c69-21361a329a01")
	)
	(text "32-bit chain U9 -> U10 -> U11 -> U12 (MSB first). U11 QD = EA19 (1 = save chip). R8 keeps EA19 low while the 595s are off.\nU13 (74HCT165) loads SD* on RD_LOAD_N and shifts it out on SR_SCK -> RB_Q7 -> U14 -> SR_MISO. CP and /PL are 3.3 V: keep it HCT."
		(exclude_from_sim no)
		(at 17.78 21.49 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "b770e5d6-22e4-5e41-a4f0-d87165805767")
	)
	(embedded_fonts no)
)
