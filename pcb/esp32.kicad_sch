	(text "ESP32-S3-WROOM-1 module (hand-soldered) + boot/reset + series resistors"
		(exclude_from_sim no)
		(at 17.78 15.24 0)
		(effects
			(font (size 2.5 2.5) (thickness 0.5) (bold yes))
			(justify left top)
		)
		(uuid "6f32490e-2f67-5881-b86b-77ce960baaba")
	)
	(text "ESP32-S3 GPIO MAP (N16R8: GPIO35-37 are used by octal PSRAM - do not use!)\nGPIO4 BUS_ESP   GPIO5 ESP_WE_N   GPIO6 ESP_OE_N   GPIO7 DOUT_OE_N\nGPIO15 RD_LOAD_N  GPIO16 MENU_WE_N  GPIO17 SNES_RST_DRV (1 = hold SNES in reset)\nGPIO18 MBX_IRQ_N  GPIO8 RESET_SENSE_N  GPIO9 SNES_5V_SENSE\nSPI2 (IOMUX): GPIO10 SR_LATCH, GPIO11 SR_MOSI, GPIO12 SR_SCK, GPIO13 SR_MISO (latch + clock via 33R R29/R28)\nSD (SPI3): GPIO1 CS, GPIO2 SCK, GPIO42 MOSI, GPIO41 MISO, GPIO38 card detect (0 = card in)\nUSB: GPIO19/20 native USB (flashing + serial), GPIO0 BOOT button, GPIO48 status LED\nSave RAM: GPIO21 SAVE_EN, GPIO14 M11, GPIO47 M12, GPIO39 M13, GPIO40 M14\nShift order (MSB first, 32 bit): DATA[7:0], A[23:16] (bit19 = EA19 save select), A[15:8], A[7:0]\nNever drive 5 V-side outputs while SNES_5V_SENSE = 0 (USB-only power: only the ESP side is alive)."
		(exclude_from_sim no)
		(at 17.78 21.49 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "fdb58a4d-46d0-5967-8a71-9576f05f0ed1")
	)
	(embedded_fonts no)
)
