	)
	(text "Reset: Q1 pulls SNES /RESET low (gate pulled up = SNES held in reset until the ESP firmware releases it).\nMailbox: with MENU_WE_N=0 the menu may write into SRAM; each write pulses MBX_IRQ_N to the ESP.\nCD74HC4050 runs from 3V3; its inputs are 5 V tolerant."
		(exclude_from_sim no)
		(at 17.78 21.49 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
