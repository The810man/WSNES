	(text "Battery-backed save RAM (LoROM $70-$7D:0000-7FFF)"
		(exclude_from_sim no)
		(at 17.78 15.24 0)
		(effects
			(font (size 2.5 2.5) (thickness 0.5) (bold yes))
			(justify left top)
		)
		(uuid "ff544768-c6cd-524a-996d-92c52a2bfaa0")
	)
	(text "Save RAM: CY62128E at LoROM $70-$7D/$F0-$FF:0000-7FFF, CR2032 backed, write-protected below 4.4 V"
		(exclude_from_sim no)
		(at 17.78 21.49 0)
		(effects
			(font (size 2 2) (thickness 0.4) (bold yes))
			(justify left top)
		)
		(uuid "64c6cb45-6b6b-5be6-8943-3cfcfe56645c")
	)
	(text "U17 decodes the LoROM save area: A22=A21=A20=1, A15=0, /ROMSEL=0 -> SAVE_SEL_N (only in SNES mode and when SAVE_EN=1).\nU19 masks A11-A14 with SAVE_M11..M14 (ESP GPIOs) so the RAM mirrors at the header size (2 KB: all 0, 8 KB: M11+M12, 32 KB: all 1).\nSome games check the mirroring (anti-copier), so set the masks from the ROM header before releasing reset.\nESP access: BUS_ESP=1, address bit EA19 (U11 QD) = 1 selects the save chip, 0 the ROM chip (set masks to 1 for full access).\nPower fail: U20 drives CE2 low below ~4.4 V, R7 holds it low when the cart is off -> no garbage writes, data kept by BT1.\nEvery SNES write to the save area pulses MBX_IRQ_N -> ESP knows the save is dirty and copies it to SD (.srm) on reset/game change."
		(exclude_from_sim no)
		(at 17.78 26.89 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "ee70a308-1ec9-594c-bb5e-6ce333afb278")
	)
	(embedded_fonts no)
)
