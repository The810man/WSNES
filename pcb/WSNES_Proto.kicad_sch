	)
	(lib_symbols)
	(text "WSNES cart v0.4 - mixed SMD/THT, standard SNES PCB shape (ESP32-S3 + 512 KB ROM-SRAM + battery-backed save RAM, LoROM)"
		(exclude_from_sim no)
		(at 17.78 15.24 0)
		(effects
			(font (size 3 3) (thickness 0.6) (bold yes))
			(justify left top)
		)
		(uuid "54b624f2-03c7-5b22-a4da-c53ee22bd37c")
	)
	(text "Assembly field: JLC = SMD assembled by JLCPCB, HAND = hand-soldered (U21 ESP module, U15 PIC, BT1, J3)"
		(exclude_from_sim no)
		(at 17.78 22.34 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "1196293f-1e3b-5f98-8ded-ba332190b43b")
	)
	(text "SIGNAL FLOW\nSNES edge (Edge_CIC) -> SNES_A* / SNES_D* / SNES_RD_N / SNES_WR_N -> SNES_Buffers (U2-U5) -> SA* / SD* -> ROM SRAM U1 and Save RAM U16\nESP32 -> SPI (SR_SCK / SR_MOSI / SR_LATCH via 33R) -> ESP_Serial (U9-U12 595 drive SA* / SD*, U13 165 reads SD* back -> SR_MISO)\nBUS_ESP (one GPIO, pulled high) selects the owner: 0 = SNES plays (U2-U5 on), 1 = ESP loads (U9-U12 on). ROM_Glue muxes /CE /OE /WE.\nLevel_Reset shifts 5 V status lines down to 3.3 V for the ESP and holds the SNES in reset until the firmware releases it.\nNet names: labels that cross sheets are GLOBAL labels (same net name everywhere); sheet-internal nets are local (/Sheet/NET).\nEvery IC has its 100 nF decoupling cap on its own sheet."
		(exclude_from_sim no)
		(at 17.78 26.89 0)
		(effects
			(font (size 1.5 1.5))
			(justify left top)
		)
		(uuid "f07883a7-d400-50fa-8d7b-39fbf4b81683")
	)
	(text "Cartridge edge + SuperCIC key\n\nP1, U15, J3, D3\n+ 3 R/C"
		(exclude_from_sim no)
		(at 27.94 60.96 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "7043dbb2-2442-5f78-a0e8-2a1d62b925ae")
	)
	(text "SNES-side bus buffers (5 V, active while BUS_ESP = 0)\n\nU2, U3, U4, U5\n+ 4 R/C"
		(exclude_from_sim no)
		(at 157.48 60.96 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "4548a6bc-a795-54f5-8842-d48223670765")
	)
	(text "ROM SRAM + bus-ownership glue\n\nU1, U8, U6, U7\n+ 4 R/C"
		(exclude_from_sim no)
		(at 287.02 60.96 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "32e36a9a-a8bb-511d-ac07-b05290f97ec5")
	)
	(text "ESP-side serial address/data access (5 V HCT shift registers)\n\nU9, U10, U11, U12, U13\n+ 6 R/C"
		(exclude_from_sim no)
		(at 27.94 109.22 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "2a063347-224b-56da-9409-a544d0165439")
	)
	(text "5 V -> 3.3 V, SNES reset driver, control-line pull-ups\n\nU14, Q1\n+ 10 R/C"
		(exclude_from_sim no)
		(at 157.48 109.22 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "cbe316fc-7bef-5052-a965-7ecaf3fbdadb")
	)
	(text "ESP32-S3-WROOM-1 module (hand-soldered) + boot/reset + series resistors\n\nU21, SW2, SW1, D7\n+ 7 R/C"
		(exclude_from_sim no)
		(at 287.02 109.22 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "8c16021c-0819-5f57-b878-f748f3a69df0")
	)
	(text "microSD socket (SPI mode, 3.3 V)\n\nJ2\n+ 7 R/C"
		(exclude_from_sim no)
		(at 27.94 157.48 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "19379f74-a61f-51cb-8b36-786cf2b77214")
	)
	(text "Power: SNES 5 V, USB-C (ESD, CC), 3.3 V LDO\n\nD1, D2, J5, U23, D6, U22\n+ 7 R/C"
		(exclude_from_sim no)
		(at 157.48 157.48 0)
		(effects
			(font (size 1.27 1.27))
			(justify left top)
		)
		(uuid "87bb32a1-7885-58e8-93e5-f4376d5b3ded")
	)
	(text "Battery-backed save RAM (LoROM $70-$7D:0000-7FFF)\n\nU16, U17, U18, U19, U20, D4, BT1\n+ 7 R/C"
