	(title_block
		(title "WSNES Flashcart v0.4 - overview")
		(date "2026-11-18")
		(rev "0.4")
		(company "WSNES project")
		(comment 1 "ESP32-S3 + 512 KB ROM-SRAM + battery save RAM, LoROM")
		(comment 2 "Generated by tools/gen_project.py from tools/design.py")
