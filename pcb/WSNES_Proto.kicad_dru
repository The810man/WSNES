(version 1)

# ---------------------------------------------------------------- planes (v0.4)
# In1 = GND plane, In2 = +5V (logic area) / +3V3 (ESP strip). Both are "power" layers (Board Setup > Layers), so
# the interactive router and freerouting stay on F.Cu / B.Cu. In v0.3 freerouting put 3.9 m of signal track on the
# planes and cut them up; this rule makes any track on an inner layer a DRC error. Reach a plane with a via.
(rule "Inner layers are planes, no tracks"
	(layer inner)
	(constraint disallow track))

# ---------------------------------------------------------------- power
# Net class Power draws 0.5 mm by default. 0.3 mm is the floor for the short stubs into TSSOP pins.
(rule "Power tracks at least 0.3 mm"
	(condition "A.NetClass == 'Power' && A.Type == 'Track'")
	(constraint track_width (min 0.3mm) (opt 0.5mm)))

# GND pins of the SMD logic/SRAM/regulator ICs join the GND pours solidly. With thermal spokes, several of these
# pads only got one spoke because tracks crowd them (DRC "starved thermal"). The ESP module (U21) is soldered by
# hand, so it keeps thermal reliefs.
(rule "GND SMD IC pins solid to pour"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && A.NetName == 'GND' && B.Type == 'Zone' && A.memberOfFootprint('U*') && !A.memberOfFootprint('U21')")
	(constraint zone_connection solid))

# ---------------------------------------------------------------- USB
# USB_DP / USB_DN are a KiCad diff pair (names end in P/N): route them with the diff-pair router (key 6).
# 0.3 / 0.2 mm on F.Cu over the In1 GND plane (0.21 mm prepreg) is about 90 ohm differential. Full Speed does not
# need it, but it keeps the pair tidy.
(rule "USB pair"
	(condition "A.NetClass == 'USB'")
	(constraint diff_pair_gap (min 0.18mm) (opt 0.2mm) (max 0.3mm))
	(constraint diff_pair_uncoupled (max 5mm))
	(constraint skew (max 1mm)))

# ---------------------------------------------------------------- vias
# Smallest via on this board: 0.45/0.2 mm (no JLC surcharge on 4 layers). Signals default to 0.5/0.25,
# power to 0.6/0.3.
(rule "Via floor"
	(condition "A.Type == 'Via'")
	(constraint via_diameter (min 0.45mm))
	(constraint hole_size (min 0.2mm)))
